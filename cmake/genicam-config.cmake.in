@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@GC_FIND_THREADS@)
	find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/genicam-common-targets.cmake")
set(genicam_common_FOUND TRUE)

if(@GC_BUILD_HOST@ AND (NOT genicam_FIND_COMPONENTS OR "host" IN_LIST genicam_FIND_COMPONENTS))
	find_dependency(EXPAT)
	find_dependency(ZLIB)
	include("${CMAKE_CURRENT_LIST_DIR}/genicam-host-targets.cmake")
	set(genicam_host_FOUND TRUE)
endif()

if(@GC_BUILD_CAMERA@ AND (NOT genicam_FIND_COMPONENTS OR "camera" IN_LIST genicam_FIND_COMPONENTS))
	include("${CMAKE_CURRENT_LIST_DIR}/genicam-camera-targets.cmake")
	set(genicam_camera_FOUND TRUE)
endif()

if(NOT genicam_FIND_COMPONENTS)
	include("${CMAKE_CURRENT_LIST_DIR}/genicam-compat-targets.cmake")
endif()

check_required_components(genicam)
